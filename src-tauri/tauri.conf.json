{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Music Player",
  "version": "0.8.0",
  "identifier": "com.localmusicplayer.app",
  "build": {
    "beforeDevCommand": "npm run setup && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run setup && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Music Player",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "resources": {
      "resources/deno.exe": "deno.exe",
      "resources/bgutil/VERSION": "bgutil/VERSION",
      "resources/bgutil/plugin": "bgutil/plugin",
      "resources/bgutil/server/src": "bgutil/server/src",
      "resources/bgutil/server/types": "bgutil/server/types",
      "resources/bgutil/server/package.json": "bgutil/server/package.json",
      "resources/bgutil/server/deno.lock": "bgutil/server/deno.lock",
      "resources/bgutil/server/tsconfig.json": "bgutil/server/tsconfig.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
