{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Music Player",
  "version": "0.6.0",
  "identifier": "com.localmusicplayer.app",
  "build": {
    "beforeDevCommand": "npm run setup && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run setup && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Music Player",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
